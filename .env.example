# Copy to .env and fill in real values. .env is gitignored.

# Deployment environment. Must be one of: dev | staging | prod.
# Dev-only routes (mock login at /api/auth/switch) only register when ENV=dev.
ENV=dev

# Required only when Gemini chat or grading is enabled.
GOOGLE_API_KEY=

# Required only when Anthropic chat or grading is enabled.
ANTHROPIC_API_KEY=

# Grader engine: ollama | gemini | anthropic
# Use ollama to grade locally without Gemini or Claude credentials.
GRADER_ENGINE=gemini

# Chat engine: disabled | gemini | anthropic
# COD-8 changes grading only. Set disabled when no cloud chat key is configured.
CHAT_ENGINE=gemini

# Local Ollama grader settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SEC=180

# Enable to allow CHAT_ENGINE=anthropic / GRADER_ENGINE=anthropic and Claude fallback.
CLAUDE_FALLBACK_ENABLED=false

# E2B Sandbox
E2B_API_KEY=e2b_your-key-here

# Postgres (docker-compose maps to 5434)
DATABASE_URL=postgres://codritium:codritium@localhost:5434/codritium?sslmode=disable

# Redis (docker-compose maps to 6381)
REDIS_URL=redis://localhost:6381

# HMAC-SHA256 secret for the session cookie. REQUIRED in every environment —
# config.Load() refuses to start when this is empty. Use a strong random value
# (>=32 bytes) per environment, never reuse across dev/staging/prod.
COOKIE_SECRET=

# Cookie domain (leave empty for host-only; set to .codritium.com in production).
COOKIE_DOMAIN=

# Session cookie Secure flag (HTTPS only). Defaults to true when ENV=prod and
# false otherwise; set true for any other deployment served over HTTPS.
# COOKIE_SECURE=false

# Public origin the browser sees (used by magic-link emails to build verify URLs).
PUBLIC_URL=http://localhost:3000

# Server port
PORT=8080

# OAuth credentials (three-way login: Google + GitHub).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=
GITHUB_OAUTH_REDIRECT_URL=

# SMTP (email magic link delivery). SMTP_PORT defaults to 587 when empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
